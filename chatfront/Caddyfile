:3000 {
	log {
		output stdout
		level INFO
	}

	encode gzip

	# /api/* → ollama interno (el navegador nunca habla con ollama directo)
	@api path /api/*
	handle @api {
		basic_auth {
			@CHAT_USER@ @CHAT_PASS_HASH@
		}
		reverse_proxy ollama:11434 {
			# default es 30s/None; explícitamente 0 porque qwen2.5vl en CPU
			# puede tardar 60-90s en la primera pasada con imagen (prefill).
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
				dial_timeout 10s
			}
		}
	}

	# SPA: libre (el usuario entra con el login de la página)
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# El index nunca queda cacheado (si no, F5 traía pantalla negra)
	header / Cache-Control "no-cache, must-revalidate"

	handle {
		root * /srv
		file_server
		try_files {path} /index.html
	}
}
