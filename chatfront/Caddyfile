:3000 {
	basic_auth {
		@CHAT_USER@ @CHAT_PASS_HASH@
	}
	encode gzip

	# /api/* → ollama interno (el navegador nunca habla con ollama directo)
	@api path /api/*
	handle @api {
		reverse_proxy ollama:11434
	}

	# Todo lo demás → SPA
	handle {
		root * /srv
		file_server
		try_files {path} /index.html
	}
}
