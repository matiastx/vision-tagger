:3000 {
	basic_auth {
		@CHAT_USER@ @CHAT_PASS_HASH@
	}
	encode gzip

	# Proxy interno a Ollama: el navegador nunca habla con ollama directo.
	# handle (sin strip): ollama espera /api/* tal cual (/api/tags, /api/chat)
	handle /api/* {
		reverse_proxy ollama:11434
	}

	# SPA
	root * /srv
	file_server
	try_files {path} /index.html
}
